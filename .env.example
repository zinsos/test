# snypra-edge environment. Copy to .env for local runs; on Railway set these as service variables.
# Secrets and infrastructure live here. Strategy knobs live in config/strategy.json.

# Postgres connection string. On Railway use the Postgres plugin reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/snypra_dev
# Force TLS on (true) or off (false). Leave unset to auto-detect (off for localhost and *.railway.internal, on otherwise).
# Flags (DATABASE_SSL, LIVE_DRY_RUN, DASHBOARD_ALLOW_OPEN) accept only true/false, 1/0, yes/no, on/off (any case, trimmed).
# An empty value means the default; anything else stops startup.
# DATABASE_SSL=true
# Pool size per service.
DB_MAX_CONNECTIONS=10

# Solana JSON-RPC endpoint (paid RPC recommended: pump.fun volume needs high rate limits).
RPC_HTTP_URL=https://your-rpc.example.com/?api-key=REPLACE_ME
# Websocket endpoint for logsSubscribe on Pump and PumpSwap. Leave empty to derive it from RPC_HTTP_URL.
RPC_WS_URL=
# Client-side rate limit and concurrency for JSON-RPC calls (wallet intel, holder snapshots, backfills).
RPC_MAX_RPS=20
RPC_MAX_CONCURRENCY=8
# processed is faster but can include transactions that later drop; confirmed is the safe default.
STREAM_COMMITMENT=confirmed

# Which components this service runs: recorder, scorer, tracker, trader, dashboard (comma separated).
# Recommended single service: recorder,scorer,tracker,trader,dashboard
# Optional split: service A (data) recorder,scorer,tracker,dashboard and service B (trading) trader.
# Only services with recorder or scorer make wallet-intel RPC calls; a trader-only service reads the stored intel.
MODULES=recorder,scorer,tracker,trader,dashboard
# paper simulates fills against live curves; live sends real transactions from the hot wallet.
TRADING_MODE=paper
# Extra paper strategies traded on the same live feed next to the main paper trader (TRADING_MODE=paper only):
# comma-separated variant names from config/lab-variants.json, e.g. momentum-loose,fast-exits, or all.
# Each runs as its own strategy run labelled paper:<name> with its own bankroll, risk limits and positions.
# Empty uses lab.livePaperVariants from the strategy config (default none); none turns them off even if the config lists some.
# Unknown names stop startup. Ignored in live mode.
PAPER_VARIANTS=
# With TRADING_MODE=live, true only simulates transactions (simulateTransaction) and never sends them.
# Empty means true. Only an explicit false/0/no/off sends real transactions.
LIVE_DRY_RUN=true
# Path of the strategy config inside the container.
STRATEGY_CONFIG=config/strategy.json

# Hot wallet secret key (base58 or JSON byte array). Only needed for TRADING_MODE=live and the sweep command.
# Fund it with the trading bankroll only. Never put the cold wallet key anywhere.
HOT_WALLET_SECRET_KEY=
# Cold wallet PUBLIC address that receives profits above sweeper.hotTargetSol. Address only, never a key.
COLD_WALLET_ADDRESS=
# Optional Jito block engine URL (e.g. https://mainnet.block-engine.jito.wtf) used when execution.useJito is true.
JITO_BLOCK_ENGINE_URL=

# Bearer token for the dashboard API, required when MODULES includes dashboard: at least 24 random characters,
# for example the output of `openssl rand -hex 24`. Open the dashboard once with ?token=... to store it in the browser.
DASHBOARD_TOKEN=
# Serve the dashboard API with no token at all. Only for a private network: the API exposes trades, positions and wallets.
# A set DASHBOARD_TOKEN is always required, even with this on.
# DASHBOARD_ALLOW_OPEN=false
# HTTP port for the dashboard and /healthz. Railway injects PORT automatically.
PORT=8080
# Interface the HTTP server binds to. Leave empty on Railway (all interfaces). Use 127.0.0.1 on a VPS
# so the dashboard is only reachable through SSH or a reverse proxy.
HOST=
# pino log level: trace, debug, info, warn, error.
LOG_LEVEL=info
# IPFS gateway used for launch metadata (twitter, telegram, website). Defaults to recorder.metadata.gateway.
METADATA_GATEWAY=
