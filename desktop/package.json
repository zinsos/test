{
  "name": "snypra-edge",
  "productName": "snypra-edge",
  "version": "0.1.0",
  "description": "Desktop window for the snypra-edge dashboard",
  "private": true,
  "type": "module",
  "main": "build/src/main.js",
  "author": "snypra-edge",
  "license": "UNLICENSED",
  "scripts": {
    "icon": "node scripts/make-icon.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.pages.json --noEmit",
    "test": "npm run build && node --test build/test/*.test.js",
    "start": "npm run build && electron .",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@types/node": "24.19.2",
    "electron": "45.0.0",
    "typescript": "5.9.3"
  }
}
